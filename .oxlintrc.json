{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "react",
    "react-perf",
    "nextjs",
    "oxc",
    "import",
    "jsdoc",
    "jsx-a11y",
    "node",
    "promise",
    "jest",
    "vitest",
    "vue"
  ],
  "categories": {
    "correctness": "error",
    "perf": "error"
  },
  "ignorePatterns": ["docs/**", "public/**"]
}
