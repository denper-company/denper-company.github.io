{
  "name": "denper",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "precompress": "cp docs/index.html docs/404.html",
    "compress": "gzip --best --keep --no-name --recursive docs",
    "dev": "vite",
    "lint": "oxlint --fix --fix-suggestions --fix-dangerously",
    "build": "vite build",
    "postbuild": "npm run compress",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "oxlint": "1.89.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  }
}
